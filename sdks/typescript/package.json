{
  "name": "@heossihq/bee",
  "version": "1.0.14",
  "description": "Bee by HEOSSI - The Progressive Quantum-Native Intelligence Engine",
  "license": "Apache-2.0",
  "author": "HEOSSI (Pte.) Ltd. <bee-support@heossi.com>",
  "homepage": "https://bee.heossi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heossihq/bee-public.git"
  },
  "bugs": {
    "url": "https://github.com/heossihq/bee-public/issues"
  },
  "keywords": [
    "bee",
    "heossi",
    "llm",
    "ai",
    "openai-compatible",
    "chat-completions",
    "lora",
    "domain-experts",
    "quantum",
    "cybersecurity",
    "blockchain",
    "mcp"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.js"
}
